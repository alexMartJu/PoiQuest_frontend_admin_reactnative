EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here

# ─── URL del backend ────────────────────────────────────────────────────────────
# DISPOSITIVO FÍSICO (Expo Go en móvil/tablet real):
#   Descomenta la línea siguiente y pon la IP local de tu PC (ver: ipconfig).
#   Asegúrate de que el backend está corriendo y el PC y el móvil están
#   en la misma red WiFi.
#
EXPO_PUBLIC_API_URL=http://your_local_ip_here:8000
#
# EMULADOR (Android Studio / iOS Simulator):
#   Deja esta variable comentada o vacía; se usará 10.0.2.2 / localhost automáticamente.
# ────────────────────────────────────────────────────────────────────────────────
